{
  "name": "munshi",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "npm run dev -w @munshi/server",
    "dev:web": "npm run dev -w @munshi/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:generate": "npm run db:generate -w @munshi/server",
    "extract:live": "npm run extract:live -w @munshi/server",
    "demo:reset": "npm run demo:reset -w @munshi/server",
    "e2e": "npm run e2e -w @munshi/server",
    "eval:attacks": "npm run eval:attacks -w @munshi/server --",
    "agent:live": "npm run agent:live -w @munshi/server",
    "check:sqlite": "node scripts/check-sqlite.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "check:readme": "node scripts/check-readme.mjs"
  },
  "devDependencies": {
    "playwright": "^1.65.1"
  }
}
