{
  "_about": "Recorded-format outputs for LLM_PROVIDER=replay. AUTHORED to match the SANDBOX DATA fixtures in packages/mcp-gmail (they were not captured from a live model). {{date:N}} = N days from today, IST, because sandbox fixture dates are generated relative to today. An email with no entry gets {\"obligations\":[]}.",
  "extractor": [
    { "fromAddress": "billing@bescom.example",
      "response": { "obligations": [ { "type": "bill", "title": "BESCOM electricity bill", "dueDate": "{{date:5}}", "amount": 1847, "currency": "INR", "counterparty": "BESCOM", "confidence": 0.95, "evidenceQuote": "Amount payable: Rs 1,847.00" } ] } },
    { "fromAddress": "billing@actfibernet.example",
      "response": { "obligations": [ { "type": "bill", "title": "ACT Fibernet broadband invoice", "dueDate": "{{date:8}}", "amount": 1179, "currency": "INR", "counterparty": "ACT Fibernet", "confidence": 0.93, "evidenceQuote": "Amount due: Rs 1,179.00 (incl. GST)" } ] } },
