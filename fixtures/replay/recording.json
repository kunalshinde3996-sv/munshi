    { "fromAddress": "ticketadmin@irctc.example",
      "response": { "obligations": [ { "type": "travel", "title": "Train to Chennai (PNR 4523817690)", "dueDate": "{{date:12}}T06:30:00+05:30", "amount": 995, "currency": "INR", "counterparty": "IRCTC", "confidence": 0.9, "evidenceQuote": "Departure: 06:30  Arrival: 11:35" } ] } },
    { "fromAddress": "info@mailer.netflix-billing.example",
      "response": { "obligations": [ { "type": "renewal", "title": "Netflix plan renewal", "dueDate": "{{date:4}}", "amount": 649, "currency": "INR", "counterparty": "Netflix", "confidence": 0.9, "evidenceQuote": "Amount: Rs 649.00 per month" } ] } },
    { "fromAddress": "no-reply@spotify-billing.example",
      "response": { "obligations": [ { "type": "renewal", "title": "Spotify Premium renewal", "dueDate": "{{date:9}}", "amount": 119, "currency": "INR", "counterparty": "Spotify", "confidence": 0.9, "evidenceQuote": "Amount: Rs 119.00" } ] } },
    { "fromAddress": "reception@smilecare-dental.example",
      "response": { "obligations": [ { "type": "appointment", "title": "Dentist appointment (Smile Care)", "dueDate": "{{date:7}}T16:30:00+05:30", "counterparty": "Smile Care Dental Clinic", "confidence": 0.95, "evidenceQuote": "Time: 4:30 PM IST" } ] } }
  ],
  "agent": {
    "_about": "Step 1 plan, per obligation (matched by title substring). $id and $senderAddress come from the obligation list the runtime shows the agent. Later steps reply with finalText.",
    "plan": [
      { "titleContains": "BESCOM", "calls": [ { "name": "create_event", "args": { "title": "BESCOM bill due (₹1,847)", "start": "{{date:5}}T09:00:00+05:30", "obligationId": "$id" } } ] },
      { "titleContains": "ACT Fibernet", "calls": [ { "name": "create_event", "args": { "title": "ACT Fibernet invoice due (₹1,179)", "start": "{{date:8}}T09:00:00+05:30", "obligationId": "$id" } } ] },
      { "titleContains": "Credit card", "calls": [ { "name": "create_event", "args": { "title": "Credit card payment due", "start": "{{date:10}}T09:00:00+05:30", "obligationId": "$id" } } ] },
      { "titleContains": "examination form", "calls": [ { "name": "create_event", "args": { "title": "Submit Semester 5 exam form", "start": "{{date:6}}T09:00:00+05:30", "obligationId": "$id" } } ] },
      { "titleContains": "Amazon refund", "calls": [
        { "name": "create_event", "args": { "title": "Check Amazon refund (₹2,499)", "start": "{{date:3}}T09:00:00+05:30", "obligationId": "$id" } },
        { "name": "create_draft", "args": { "to": ["$senderAddress"], "subject": "Where is my refund?", "body": "Hello, my refund of ₹2,499 for the returned headphones has not arrived yet. Could you please confirm the status?", "obligationId": "$id" } } ] },
