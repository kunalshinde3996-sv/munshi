# --- Server ---
PORT=8787
DATABASE_PATH=./data/munshi.db
# SANDBOX DATA store (JSON files shared with the MCP child processes). Delete the folder to reset.
SANDBOX_STORE_DIR=./data/sandbox

# --- LLM (provider + model id are always read from env; nothing is hardcoded) ---
# LLM_PROVIDER: gemini | anthropic | replay  (replay = scripted sample outputs from fixtures/replay, no API key, UI shows a DEMO MODE banner)
LLM_PROVIDER=replay
LLM_MODEL=
# Optional: tried only after LLM_MODEL fails 3x (429/503/timeout) with backoff
LLM_FALLBACK_MODEL=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# --- Google OAuth (needed only for "google" mode, milestone M6) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Register EXACTLY this redirect URI in the Google Cloud OAuth client:
#   http://localhost:8787/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:8787/auth/google/callback
# Where the browser is sent after Google consent
WEB_ORIGIN=http://localhost:5173
# Extra allowed browser origins, comma-separated. localhost / 127.0.0.1 on any port are always allowed outside production.
# ALLOWED_ORIGINS=

# --- Token encryption (AES-256-GCM). 32 bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# --- LLM pacing: max requests/minute across extractor + agent (0 = off) ---
LLM_RPM=8

# --- Telegram (optional): approvals + due-date nudges on your phone. Leave empty to disable. ---
# 1) @BotFather -> /newbot -> token here. 2) send /start to your bot, it replies with your chat id -> TELEGRAM_CHAT_ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Background scan period in minutes (0 = off) ---
SCAN_INTERVAL_MIN=30

# --- SANDBOX mailbox: also include the 30 attack/benign evaluation emails from fixtures/attacks (true|false) ---
SANDBOX_ATTACK_EMAILS=false

# --- Guard ---
SEND_HOLD_SECONDS=60

# --- Login (single user, no registration, no password reset). Seeded at server start; change the password here and restart. ---
DEMO_USER_EMAIL=demo@munshi.local
DEMO_USER_PASSWORD=munshi-demo-2026
